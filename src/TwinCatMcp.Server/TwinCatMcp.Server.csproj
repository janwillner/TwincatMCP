<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TwinCatMcp</RootNamespace>
    <AssemblyName>TwinCatMcp.Server</AssemblyName>
    <Version>0.1.1</Version>
    <!-- COM interop types are embedded; no Beckhoff DLL needs to be shipped. -->
    <NoWarn>$(NoWarn);CA1416;CS1591</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Beckhoff.TwinCAT.Ads" Version="7.0.389" />
    <!-- TwinCAT Automation Interface interop (TCatSysManagerLib 3.4 = TwinCAT 3.1.4026). The package embeds the interop
         types, so the build needs no installed TwinCAT and the server also runs against 4024 (see ComCapability). -->
    <PackageReference Include="Beckhoff.TwinCAT.TCatSysManager" Version="4026.22.0" ExcludeAssets="runtime" />
    <PackageReference Include="envdte" Version="17.14.40260" />
    <PackageReference Include="envdte80" Version="17.14.40260" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>

</Project>
